}{
 {"","","","000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f","5281ba8e0921f9d3f4af89ca87e486d2e5a0e3d9ae2765129fe8c24162a75dd4",49199,1794160150},
 {"","","","000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f","ef496b19f9b0d8213d693ae940b5c3c6f7a50e1aebe2bc7db1d2523ee7d88329",49199,1794160150},
 {"","","","000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f","b9450f7acf536437180f130ce11673b1b82ac10943c375efd847054c6509dcb7",49199,1794160150},
 {"","","","000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f","1f90f3152fc00061c3e6bee94cf85e753140748aecba50892451fe6d58d352d1",49199,1794160150},
 {"","0c00006f03001d20714b5b57e989b773f2b9da9f9244df45ea6d8096ac2a9d8c26a8d3b48bfae83c040300473045022034fbba8b5518eb71426ba9b66494cbe0740ed50b0c4ddba4d5252d95afad2a220221009dac8dd5c89268c853a590480a422a09a07c697aadc5768f872c26251906f024","","000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f","9b92c43c004624d6157d017348edb4570868901c498ac58a634adc62ee0567f6",49195,1794160150},
 {"","0c00008f030017410443dbfd1cbc0e596aba81fd7bbb1eb95329d1b80c73f57543d0e03fc15d879376d88312a53fec2b5778dc0a6c4de3c2aeb33cfbb423817e71faf7a185e69ad82f0403004630440220192f9f15613f4a464f48755cb31b3d95e5df96000caa75b9c211ec03dde50a75022073dd7ba78702f870ef65c3d6eca0cc8439cb9884230bd568e8641bb8a832d5d2","","000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f","a69d00e9578fedb3a17af3813b7f75e1af69b6238a51eee8e33b8c2ad2964525",49195,1794160150},
}
TLS12_Auth_Test_Fixture :: struct {
 certificate, ske, root_der: []u8,
 certs: Server_Certificates,
 root: x509.Certificate,
 client, server: [32]u8,
 cipher: u16,
 now: time.Time,
}
tls12_auth_test_fixture :: proc(index: int) -> (f: TLS12_Auth_Test_Fixture) {
 v := TLS12_AUTH_TEST_VECTORS[index]
 f.certificate = tls12_test_bytes(v.certificate)
 f.ske = tls12_test_bytes(v.ske)
 f.root_der = tls12_test_bytes(v.root)
 f.client = tls12_test_array(32,v.client); f.server = tls12_test_array(32,v.server)
 f.cipher, f.now = v.cipher, time.unix(v.now,0)
 certs,ce:=tls12_server_certificates_parse(f.certificate); assert(ce.kind==.None)
 f.certs=certs
 root,re:=x509.parse(f.root_der);assert(re==.None);f.root=root
 return
}
tls12_auth_test_destroy :: proc(f: ^TLS12_Auth_Test_Fixture) {
 server_certificates_destroy(&f.certs);x509.destroy(&f.root)
 delete(f.certificate);delete(f.ske);delete(f.root_der);f^={}
}
tls12_auth_test_offers :: proc() -> ([2]Named_Group,[3]Signature_Scheme) {
 return {.X25519,.SECP256R1},{.RSA_PKCS1_SHA256,.RSA_PSS_RSAE_SHA256,.ECDSA_SECP256R1_SHA256}
}
tls12_auth_test_put24 :: proc(dst: []u8,n: int) {dst[0],dst[1],dst[2]=u8(n>>16),u8(n>>8),u8(n)}

@(test)
tls12_auth_openssl_certificate_and_ske :: proc(t: ^testing.T) {
 groups,schemes:=tls12_auth_test_offers()
 for i in 0..<len(TLS12_AUTH_TEST_VECTORS) {
  f:=tls12_auth_test_fixture(i);defer tls12_auth_test_destroy(&f)
  testing.expect_value(t,f.certs.count,2)
  roots:=[1]^x509.Certificate{&f.root}
  view,e:=tls12_authenticate_server_key_exchange(&f.certs,f.ske,{server_name="fixture.test",root_cas=roots[:]},f.client,f.server,f.cipher,groups[:],schemes[:],f.now)
  testing.expect_value(t,e.kind,.None)
  testing.expect(t,view.group==(.X25519 if i%2==0 else .SECP256R1))
  testing.expect(t,bytes.alias(view.parameters,f.ske) && bytes.alias(view.public_key,f.ske) && bytes.alias(view.signature,f.ske))
  testing.expect_value(t,view.scheme,schemes[i/2])
  // Cryptographic signature and point checks allocate no backing.
  old:=context;context.allocator=mem.nil_allocator();context.temp_allocator=mem.nil_allocator()
  _,verified:=tls12_verify_server_key_exchange(&f.certs,f.ske,f.client,f.server,f.cipher,groups[:],schemes[:])
  context=old
  testing.expect_value(t,verified.kind,.None)
 }
}

@(test)
tls12_auth_rejects_modified_exchange_identity_and_offers :: proc(t: ^testing.T) {
 groups,schemes:=tls12_auth_test_offers()
 for i in 0..<len(TLS12_AUTH_TEST_VECTORS) {
  f:=tls12_auth_test_fixture(i);defer tls12_auth_test_destroy(&f)
  wrong_client:=f.client;wrong_client[0]~=1
  wrong_server:=f.server;wrong_server[31]~=1
  for wrong in 0..<2 {
   _,e:=tls12_verify_server_key_exchange(&f.certs,f.ske,wrong_client if wrong==0 else f.client,wrong_server if wrong==1 else f.server,f.cipher,groups[:],schemes[:])
   testing.expect_value(t,e.kind,.Invalid_Signature)
  }
  wrong_cipher:=TLS12_ECDHE_ECDSA_AES128_GCM_SHA256 if f.cipher==TLS12_ECDHE_RSA_AES128_GCM_SHA256 else TLS12_ECDHE_RSA_AES128_GCM_SHA256
  _,cipher_error:=tls12_verify_server_key_exchange(&f.certs,f.ske,f.client,f.server,wrong_cipher,groups[:],schemes[:])
  testing.expect_value(t,cipher_error.kind,.Cipher_Key_Mismatch)
  for at in 0..<len(f.ske) {
   changed:=make([]u8,len(f.ske));copy(changed,f.ske);changed[at]~=1
   view,e:=tls12_verify_server_key_exchange(&f.certs,changed,f.client,f.server,f.cipher,groups[:],schemes[:])
   delete(changed)
   testing.expect(t,e.kind!=.None && len(view.parameters)==0 && len(view.public_key)==0)
  }
  _,no_group:=tls12_server_key_exchange_parse(f.ske,nil,schemes[:]);testing.expect_value(t,no_group.kind,.Unoffered_Curve)
  _,no_scheme:=tls12_server_key_exchange_parse(f.ske,groups[:],nil);testing.expect_value(t,no_scheme.kind,.Unoffered_Signature)
  other:=tls12_auth_test_fixture((i+2)%len(TLS12_AUTH_TEST_VECTORS));defer tls12_auth_test_destroy(&other)
  _,other_key:=tls12_verify_server_key_exchange(&other.certs,f.ske,f.client,f.server,f.cipher,groups[:],schemes[:])
  testing.expect(t,other_key.kind!=.None)
 }
}

@(test)
tls12_auth_rejects_trust_name_time_usage_and_small_rsa :: proc(t: ^testing.T) {
 groups,schemes:=tls12_auth_test_offers()
 f:=tls12_auth_test_fixture(0);defer tls12_auth_test_destroy(&f)
 other:=tls12_auth_test_fixture(2);defer tls12_auth_test_destroy(&other)
 unsupported:=tls12_auth_test_fixture(4);defer tls12_auth_test_destroy(&unsupported)
 roots:=[1]^x509.Certificate{&f.root};wrong_roots:=[1]^x509.Certificate{&other.root}
 unsupported_roots:=[1]^x509.Certificate{&unsupported.root}
 samples:=[]struct{name:string,roots:[]^x509.Certificate,now:time.Time,want:x509.Error}{
  {"wrong.test",roots[:],f.now,.Hostname_Mismatch},
  {"fixture.test",wrong_roots[:],f.now,.Unknown_Authority},
  {"fixture.test",unsupported_roots[:],f.now,.Unsupported_Algorithm},
  {"fixture.test",roots[:],time.time_add(f.now,31*24*time.Hour),.Expired},
  {"fixture.test",roots[:],time.time_add(f.now,-120*time.Second),.Not_Yet_Valid},
 }
 for v in samples {
  view,e:=tls12_authenticate_server_key_exchange(&f.certs,f.ske,{server_name=v.name,root_cas=v.roots},f.client,f.server,f.cipher,groups[:],schemes[:],v.now)
  testing.expect_value(t,e.kind,.Invalid_Certificates)
  testing.expect_value(t,e.authentication.x509,v.want)
  testing.expect_value(t,len(view.parameters),0)
 }
 f.certs.chain[0].key_usage={.Key_Encipherment};f.certs.chain[0].has_key_usage=true
 _,usage:=tls12_verify_server_key_exchange(&f.certs,f.ske,f.client,f.server,f.cipher,groups[:],schemes[:])
 testing.expect(t,usage.kind==.Invalid_Certificates && usage.authentication.kind==.Invalid_Certificate_Usage)
 f.certs.chain[0].key_usage={.Digital_Signature}
 // A publicly valid1024-bit RSA primitive must not lower the TLS policy.
 old_n:=f.certs.chain[0].rsa_n
 f.certs.chain[0].rsa_n=old_n[len(old_n)-128:]
 _,small:=tls12_verify_server_key_exchange(&f.certs,f.ske,f.client,f.server,f.cipher,groups[:],schemes[:])
 f.certs.chain[0].rsa_n=old_n
 testing.expect(t,small.kind==.Invalid_Certificates && small.authentication.kind==.Invalid_Public_Key)
}

@(test)
tls12_auth_certificate_and_ske_framing_bounds :: proc(t: ^testing.T) {
 groups,schemes:=tls12_auth_test_offers()
 f:=tls12_auth_test_fixture(0);defer tls12_auth_test_destroy(&f)
 for cut in 0..<len(f.certificate) {
  certs,e:=tls12_server_certificates_parse(f.certificate[:cut]);server_certificates_destroy(&certs)
  testing.expect(t,e.kind!=.None && certs.count==0)
 }
 for cut in 0..<len(f.ske) {
  view,e:=tls12_server_key_exchange_parse(f.ske[:cut],groups[:],schemes[:])
  testing.expect(t,e.kind!=.None && len(view.parameters)==0)
 }
 empty:=[7]u8{11,0,0,3,0,0,0}
 _,ee:=tls12_server_certificates_parse(empty[:]);testing.expect_value(t,ee.kind,.Empty_Certificate_List)
 zero:=[10]u8{11,0,0,6,0,0,3,0,0,0}
 _,ze:=tls12_server_certificates_parse(zero[:]);testing.expect_value(t,ze.kind,.Invalid_Certificate)
 // Exact certificate-count cap, with real parsed DER tables on every entry.
 der:=f.certs.chain[0].raw
 for count in ([2]int{16,17}) {
  message:=make([]u8,7+count*(3+len(der)));message[0]=11
  tls12_auth_test_put24(message[1:4],len(message)-4);tls12_auth_test_put24(message[4:7],len(message)-7)
  at:=7
  for _ in 0..<count {tls12_auth_test_put24(message[at:at+3],len(der));at+=3;copy(message[at:],der);at+=len(der)}
  certs,e:=tls12_server_certificates_parse(message)
  testing.expect(t,(e.kind==.None && certs.count==16) if count==16 else (e.kind==.Too_Many_Certificates && certs.count==0))
  server_certificates_destroy(&certs);delete(message)
 }
 oversized:=make([]u8,MAX_CERTIFICATE_MESSAGE_SIZE+1);defer delete(oversized)
 _,over:=tls12_server_certificates_parse(oversized);testing.expect_value(t,over.kind,.Message_Oversized)
 ske_over:[TLS12_MAX_SERVER_KEY_EXCHANGE_SIZE+1]u8
 _,ske_error:=tls12_server_key_exchange_parse(ske_over[:],groups[:],schemes[:]);testing.expect_value(t,ske_error.kind,.Message_Oversized)
}

TLS12_Auth_Test_Heap :: struct {
 backing: mem.Allocator,
 calls,fail_at,live: int,
 pointers: [256]rawptr,
 sizes: [256]int,
 bad_free: bool,
}
tls12_auth_test_allocator :: proc(a:^TLS12_Auth_Test_Heap)->mem.Allocator {return {tls12_auth_test_alloc,a}}
tls12_auth_test_alloc :: proc(data:rawptr,mode:mem.Allocator_Mode,size,alignment:int,old:rawptr,old_size:int,loc:=#caller_location)->([]u8,mem.Allocator_Error) {
 a:=cast(^TLS12_Auth_Test_Heap)data
 #partial switch mode {
 case .Alloc,.Alloc_Non_Zeroed:
  a.calls+=1
  if a.calls==a.fail_at {return nil,.Out_Of_Memory}
  grant,e:=a.backing.procedure(a.backing.data,mode,size,alignment,nil,0,loc)
  if e!=nil {return grant,e}
  if len(grant)==0 {return grant,e}
  recorded:=false
  for i in 0..<len(a.pointers) {if a.pointers[i]==nil {a.pointers[i]=raw_data(grant);a.sizes[i]=len(grant);recorded=true;break}}
  assert(recorded);a.live+=len(grant);return grant,e
 case .Resize,.Resize_Non_Zeroed:
  return mem.default_resize_bytes_align(([^]u8)(old)[:old_size],size,alignment,tls12_auth_test_allocator(a),loc)
 case .Free:
  if old==nil {return nil,nil}
  found:=false
  for i in 0..<len(a.pointers) {if a.pointers[i]==old {found=true;a.live-=a.sizes[i];a.pointers[i]=nil;a.sizes[i]=0;break}}
  if !found {a.bad_free=true;return nil,.Invalid_Argument}
  return a.backing.procedure(a.backing.data,mode,size,alignment,old,old_size,loc)
 case: return nil,.Mode_Not_Implemented
 }
}

@(test)
tls12_auth_real_heap_failure_rollback_and_chain_admission :: proc(t: ^testing.T) {
 f:=tls12_auth_test_fixture(0);defer tls12_auth_test_destroy(&f)
 groups,schemes:=tls12_auth_test_offers()
 roots:=[1]^x509.Certificate{&f.root}
 original:=context
 baseline:=TLS12_Auth_Test_Heap{backing=original.allocator}
 context.allocator=tls12_auth_test_allocator(&baseline)
 certs,ok:=tls12_server_certificates_parse(f.certificate)
 server_certificates_destroy(&certs);context=original
 testing.expect(t,ok.kind==.None && baseline.live==0 && !baseline.bad_free && baseline.calls>0)
 for fail_at in 1..=baseline.calls {
  a:=TLS12_Auth_Test_Heap{backing=original.allocator,fail_at=fail_at}
  context.allocator=tls12_auth_test_allocator(&a)
  partial,e:=tls12_server_certificates_parse(f.certificate)
  // Assert before any cleanup: failed parser itself must return no owned tables.
  testing.expect(t,e.kind==.Invalid_Certificate && e.x509==.Allocation_Failed && partial.count==0 && a.live==0 && !a.bad_free)
  server_certificates_destroy(&partial);context=original
 }
 a:=TLS12_Auth_Test_Heap{backing=original.allocator,fail_at=1}
 context.allocator=tls12_auth_test_allocator(&a)
 view,denied:=tls12_authenticate_server_key_exchange(&f.certs,f.ske,{server_name="fixture.test",root_cas=roots[:]},f.client,f.server,f.cipher,groups[:],schemes[:],f.now)
 context=original
 testing.expect(t,denied.kind==.Invalid_Certificates && denied.authentication.x509==.Allocation_Failed && len(view.parameters)==0 && a.live==0 && !a.bad_free)
}

@(test)
tls12_auth_point_and_signature_syntax :: proc(t:^testing.T) {
 groups,schemes:=tls12_auth_test_offers()
 f:=tls12_auth_test_fixture(1);defer tls12_auth_test_destroy(&f)
 message:=make([]u8,len(f.ske));defer delete(message)
 for fault in 0..<6 {
  copy(message,f.ske)
  want:=TLS12_Authentication_Error_Kind.Invalid_Point
  switch fault {
  case 0: for &b in message[8:8+65] {b=0};message[8]=4
  case 1: message[8]=2 // Compressed points were never offered.
  case 2: message[4]=1;want=.Unsupported_Curve
  case 3: message[5],message[6]=0,24;want=.Unsupported_Curve
  case 4: message[73],message[74]=8,7;want=.Unsupported_Signature
  case 5: message[75],message[76]=0,0;want=.Length_Mismatch
  }
  view,e:=tls12_server_key_exchange_parse(message,groups[:],schemes[:])
  testing.expect_value(t,e.kind,want);testing.expect_value(t,len(view.parameters),0)
 }
}
