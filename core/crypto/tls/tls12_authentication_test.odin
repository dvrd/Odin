// Actual independently captured OpenSSL TLS1.2 server flights. Regenerate with
// shared/.webtools-worktrees/native133/evidence/tls12-auth/generate.py and
// write_tests.py. Numerical public data only; no fixture private key retained.
TLS12_AUTH_TEST_VECTORS := [?]struct {
 certificate, ske, root, client, server: string,
 cipher: u16,
