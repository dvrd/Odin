package compress_brotli

// RFC 7932 Appendix B: the 121 word transforms applied to static dictionary
// words, as (prefix, operation, suffix).

Transform_Kind :: enum u8 {
	Identity        = 0,
	Omit_Last_1     = 1,
	Omit_Last_9     = 9,
	Uppercase_First = 10,
	Uppercase_All   = 11,
	Omit_First_1    = 12,
	Omit_First_9    = 20,
}

Transform :: struct {
	prefix: string,
	kind:   u8,
	suffix: string,
}

TRANSFORM_COUNT :: 121

@(rodata)
TRANSFORMS := [TRANSFORM_COUNT]Transform {
